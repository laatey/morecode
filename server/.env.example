# Copy to .env and fill in. Required in production: TOKEN_SECRET, APP_URL, POSTGRES_PASSWORD, and a way to send email.
TOKEN_SECRET=change-me-to-a-long-random-string
APP_URL=https://api.example.com
POSTGRES_PASSWORD=change-me-too
# Outside docker compose, point at your own database instead (add DATABASE_SSL=true if your host insists on TLS):
# DATABASE_URL=postgres://user:password@host:5432/morecode
ANTHROPIC_API_KEY=

# ---- Payments (Paystack) ----
# Use a test key (sk_test_...) until you are ready, then the live one (sk_live_...).
PAYSTACK_SECRET_KEY=
# The currency your Paystack account charges in (Ghana: GHS).
PAYSTACK_CURRENCY=GHS
# Price per month, in whole units of that currency. These are PLACEHOLDERS: set your own.
# "Yearly" is the per-month price when paid for the year; the customer is charged 12 times it, once.
PRICE_PRO_MONTHLY=250
PRICE_PRO_YEARLY=200
PRICE_MAX_MONTHLY=1250
PRICE_MAX_YEARLY=1060
# Card only by default, because a card can be charged again every month. Add mobile_money (comma separated)
# only if you accept that mobile-money payers may have to pay again by hand each period.
PAYSTACK_CHANNELS=card
# Optional: use plans you made in the Paystack dashboard instead of letting the server create them.
# PAYSTACK_PLAN_PRO_MONTHLY=PLN_xxx
# PAYSTACK_PLAN_PRO_YEARLY=PLN_xxx
# PAYSTACK_PLAN_MAX_MONTHLY=PLN_xxx
# PAYSTACK_PLAN_MAX_YEARLY=PLN_xxx

# Email (pick one). Without either, sign-up codes are only printed to the log.
RESEND_API_KEY=
MAIL_FROM=MoreCode <no-reply@example.com>
# Sign in with Google / GitHub (each is on only when both values are set).
# Callback URLs to register:  APP_URL/v1/auth/oauth/google/callback  and  APP_URL/v1/auth/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: a JSON file {"latest":"1.1.0","notes":["..."],"url":"https://..."} for "Check for updates"
RELEASES_FILE=
